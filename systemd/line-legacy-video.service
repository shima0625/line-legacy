[Unit]
Description=LINE Legacy optional LINEJS video worker
After=network-online.target line-legacy-linejs-bridge.service
Wants=network-online.target line-legacy-linejs-bridge.service

[Service]
Type=simple
User=linelegacy
Group=linelegacy
WorkingDirectory=/opt/line-legacy/linejs-bridge
EnvironmentFile=-/etc/line-legacy/line-legacy.env
ExecStart=/usr/bin/node /opt/line-legacy/linejs-bridge/video_worker.mjs
Restart=always
RestartSec=15
NoNewPrivileges=true

[Install]
WantedBy=line-legacy.target
