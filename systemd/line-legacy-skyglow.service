[Unit]
Description=LINE Legacy optional Skyglow push notifier
After=line-legacy-linejs-bridge.service
Wants=line-legacy-linejs-bridge.service

[Service]
Type=simple
User=linelegacy
Group=linelegacy
WorkingDirectory=/opt/line-legacy
EnvironmentFile=-/etc/line-legacy/line-legacy.env
ExecStart=/opt/line-legacy/venv/bin/python /opt/line-legacy/line_skyglow_notify.py
Restart=always
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=line-legacy.target
