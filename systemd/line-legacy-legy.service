[Unit]
Description=LINE Legacy protocol gateway
After=network-online.target line-legacy-cdn.service
Wants=network-online.target line-legacy-cdn.service

[Service]
Type=simple
User=linelegacy
Group=linelegacy
WorkingDirectory=/opt/line-legacy
EnvironmentFile=-/etc/line-legacy/line-legacy.env
Environment=ARTIFACTS_DIR=/opt/line-legacy
Environment=READ_OP_TYPE=0
Environment=FOPS_HOLD=8
Environment=FOPS_MAX_HOLD=1
# ★3.7.1 の初回ログイン(利用登録)に必須。これが無いと registerDeviceWithIdentityCredential
#   まで進まず、確認を押しても画面が動かない。
Environment=NATIVE_REGISTRATION=1
Environment=FORWARD_CACHE_METHODS=getActivePurchaseVersions,getActivePurchases
Environment=FORWARD_CACHE_TTL=3600
Environment=STICKER_PSTATUS_FIELDS=
Environment=STICKER_PAYMENTTYPE=0
Environment=FORWARD_METHODS=issueChannelToken,approveChannelAndIssueChannelToken,getChannelInfo,syncChannelData,getChannelNotificationSettings,getChannels,findContactByUserid,generateUserTicket,findContactByUserTicket,invalidateUserTicket,getPromotedBuddyContacts,getPopularBuddyLists,getNewlyReleasedBuddyIds,getBuddyDetail,getBuddyOnAir,getBuddyContacts,findBuddyContactsByQuery,getContact,findAndAddContactsByMid,updateProfileAttribute
ExecStart=/opt/line-legacy/venv/bin/python /opt/line-legacy/legy_proxy.py --cert /etc/line-legacy/server.pem --port 443 --log /opt/line-legacy/proxy.log
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
Restart=always
RestartSec=15

[Install]
WantedBy=line-legacy.target
