[Unit]
Description=LINE Legacy lab DNS redirector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=linelegacy
Group=linelegacy
WorkingDirectory=/opt/line-legacy
EnvironmentFile=-/etc/line-legacy/line-legacy.env
ExecStart=/opt/line-legacy/venv/bin/python /opt/line-legacy/dns_probe.py --bind 0.0.0.0 --ip ${LINE_LEGACY_SERVER_IP} --upstream 1.1.1.1 --port 53 --log /opt/line-legacy/dns_probe.log
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
Restart=always
RestartSec=10

[Install]
WantedBy=line-legacy.target
