# Copy values into /etc/line-legacy/line-legacy.env on the compatibility host.
# Never commit the real file.
LINE_LEGACY_HOME=/opt/line-legacy
LINE_LEGACY_SERVER_IP=127.0.0.1
LINE_LEGACY_PHONE_IP=127.0.0.1
LINE_LEGACY_CALL_HOST=127.0.0.1
LINE_LEGACY_CALL_BIND=0.0.0.0
LINE_LEGACY_CALL_PORT=19000
LINE_LEGACY_CALL_MEDIA_PORT=20000
# LINEBridge Tweakを使わない検証時にだけ、任意の
# line-legacy-dns.service が下記の名前を母艦へ向ける。
# Tweak利用時はDNSサービスを有効化する必要はない。
LINE_LEGACY_DNS_HOSTS=gw.line.naver.jp,gwx.line.naver.jp,gd2.line.naver.jp,t.line.naver.jp,legy-jp.line.naver.jp,appresources.line.naver.jp,dl.stickershop.line.naver.jp,os.line.naver.jp,dl.os.line.naver.jp,dl.shop.line.naver.jp,timeline.line.naver.jp,myhome.line.naver.jp,homeapi.line.naver.jp,tauth.line.naver.jp,openapis.jboard.navercorp.jp,cafeapi.line.naver.jp
LINE_LEGACY_EAS1_SOCKET=/run/line-eas1/eas1.sock
LINE_LEGACY_NOTICES_FILE=/opt/line-legacy/notices.json
LINE_LEGACY_SKYGLOW_URL=http://127.0.0.1:3023/send
# 端末の設定画面に入れたサーバーのアドレス。Skyglowはこの値とルーティング
# トークンの組で配送先を決めるので、上のURLとは別に一致させる必要がある。
# 共用サーバーを使う場合は preloading.dev のようにそのホスト名を書く。
LINE_LEGACY_SKYGLOW_SERVER_ADDRESS=linepush.test
# Optional portable/Docker alternative to querying the local Skyglow database.
# Comma-separate multiple 64-character hexadecimal routing tokens.
# 各トークンに `<ルーティング>:<端末のe2ee鍵>` の形で端末の鍵を付けると、通知を
# 母艦で暗号化してから送るのでサーバー側は本文を読めない。共用サーバーを
# 使う場合はこの形にすること。
LINE_LEGACY_SKYGLOW_ROUTING_KEYS=
# Keep the legacy Timeline limited to followed accounts. Set to 1 only if
# VOOM recommendation/discovery posts should fill a short feed.
TIMELINE_INCLUDE_RECOMMENDED=0
# メディア送信の確定op(SEND_CONTENT)を拾う間隔(秒)。既定の0.2だと、送信直後に
# 3.7.1 が一瞬「!」を出すことがある。
FOPS_TICK=0.05
LINEJS_BRIDGE_DIR=/opt/line-legacy/linejs-bridge

# Account-specific values. Fill these only on the host.
SELF_MID=
# E.164 format (for example +81...). Keeps the legacy client's local `tel`
# stable; modern profile APIs may return an opaque value instead.
LINE_LEGACY_PHONE=
LINE_LEGACY_RING_FROM=

# Compatibility switches used by the 3.7.1 gateway.
CHUNKED=1
C5_HDR=none
KEEP_ALIVE=1
HTTP_SYNTH=1
SYNTH=1
GETCOUNTRY=jp
MEDIA_CONFIRM=1
MORETAB=1
CDN_BACKEND=127.0.0.1:8081
# URL reachable by the legacy device. Used for video playback so the media
# process does not depend on per-app DNS hooks.
LINE_LEGACY_MEDIA_BASE=http://bridge-host-or-ip:8081
